{
  "rules": {
    "admins": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "decks": {
      "hiya-flow01-20261019": {
        "state": {
          ".read": true,
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['slide', 'locked', 'pdf'])",
          "slide": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 36 && newData.val() % 1 === 0"
          },
          "locked": {
            ".validate": "newData.isBoolean()"
          },
          "pdf": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "reviewInbox": {
          "$id": {
            "$other": {
              ".validate": false
            },
            ".write": "!data.exists() && newData.exists()",
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 1000"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            ".validate": "newData.hasChildren(['text','createdAt'])"
          },
          ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "publicReviews": {
          ".indexOn": [
            "createdAt"
          ],
          ".read": true,
          "$id": {
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 1000"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            ".validate": "newData.hasChildren(['text','createdAt'])"
          }
        }
      }
    }
  }
}
